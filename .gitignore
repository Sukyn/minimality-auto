# Ignore files by default; include the project files listed below.
*

# Repository metadata and installation instructions.
!.gitignore
!README.md
!pyproject.toml

# Project documentation.
!docs/
!docs/**/
!docs/**/*.md

# Python source files.
!src/
!src/**/
!src/**/*.py

# Test source code.
!tests/
!tests/**/
!tests/**/*.py

# JSON theory/fragments used as tool inputs.
!theories/
!theories/**/
!theories/**/*.json
